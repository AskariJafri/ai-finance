# Copy to .env (repo root, for docker compose) and/or backend/.env (local runs).
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=local
DEBUG=true

# --- Database ---
# Local (host) run:
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance
# (docker-compose overrides host to `postgres` automatically.)
#
# Serverless hosts (Vercel) only. A container should leave both false: it wants
# the pool it already has. Set both true when DATABASE_URL points at a PgBouncer
# endpoint such as Neon's `-pooler` host.
#   DATABASE_NULL_POOL=true      # hold no connections between requests
#   DATABASE_PGBOUNCER=true      # disable prepared-statement caching
#
# Seed the category taxonomy during startup. Leave true for a container; the
# Vercel build step seeds instead, so set it false there to keep the write and
# its retry sleep off every cold start.
#   SEED_ON_STARTUP=false

# --- Auth ---
# Use a long random value in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-only-change-me-please-32bytes-minimum-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Encryption (Fernet key for Plaid tokens at rest) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=4PTH4_NPOhCUjxEbht1uWz57QZ3QO7en_SfjIqrAuHU=

# --- Plaid ---
# Leave client id/secret blank to run against the built-in MockPlaidClient.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US,CA
PLAID_REDIRECT_URI=
# Force the mock even if credentials are present:
PLAID_USE_MOCK=false

# --- SnapTrade (brokerage link + live order execution) ---
# Wealthsimple/Questrade publish no API of their own; SnapTrade fronts them.
# Keys from https://dashboard.snaptrade.com/signup (free tier = 5 connections,
# personal use). Leave blank to use the mock broker.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# MASTER KILL SWITCH for real money. While false, approving an order is
# refused and you mark trades executed by hand as before. Setting this true
# with valid keys above lets an approved order reach your real broker.
SNAPTRADE_TRADING_ENABLED=false
# Force the mock broker even when credentials are present.
SNAPTRADE_USE_MOCK=false

# --- AI (hosted, OpenAI-compatible endpoint) ---
# Defaults target OpenRouter's free tier: sign up at https://openrouter.ai/keys
# (no credit card) and paste the key below. Leave LLM_API_KEY blank to run with
# AI off — every feature degrades to its rules-based answer rather than failing.
#
# Free-model quota: 20 requests/minute and 50 requests/day (1,000/day once you
# have bought $10 of credits at any point). One request per chat message, per
# advice generation, and per committee ticker.
#
# Any OpenAI-compatible host works — swap these three values for Groq
# (https://api.groq.com/openai/v1), Cerebras, or the Hugging Face router.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_API_KEY=
#
# Fallbacks, tried in the order listed when the endpoint above cannot answer —
# spent daily quota, an outage, a truncated reply. Preference order, not
# round-robin: the primary answers whenever it can, so a fallback only changes
# which model replies on the days you would otherwise have had no AI at all.
# Each free tier is metered on its own key, so a second entry is a second
# allowance. Groq is the easiest to add (https://console.groq.com/keys):
# Each entry also takes optional max_tokens / max_concurrency / extra_body,
# because rate limits are per account. Groq's free tier is the worked example:
# 1000 requests a DAY but only 8000 tokens a MINUTE, and max_tokens is reserved
# against that budget — so the global 6 x 3500 never fits, while 2 x 2000 does.
# extra_body carries provider-specific fields; gpt-oss spends ~85% of its output
# reasoning, and "reasoning_effort":"low" takes a committee verdict from 2146
# tokens to 929 without changing the verdict.
# Check your key's own /models list before choosing one — model availability
# differs per account.
#
# WHAT ACTUALLY BUYS YOU AVAILABILITY: distinct providers, not distinct models.
# The daily allowance is metered per API KEY, and the breaker is keyed on
# (base_url, api_key) — so five models on one OpenRouter key share ONE daily
# budget. Five keys across five companies are five budgets. Extra models on a
# key you already have are still worth adding, but only for per-model outages,
# so put them at the BOTTOM of the ladder.
#
# Order is preference order: the first entry that can answer does, so put the
# model you actually want first and treat the rest as insurance. A member with
# a blank api_key is dropped at startup rather than tried and benched.
#
# Free-tier, OpenAI-compatible candidates worth a key each. VERIFY each one's
# current terms and its own /models list before committing to a model string —
# free-tier availability moves constantly:
#   Groq          https://console.groq.com/keys              api.groq.com/openai/v1
#   Cerebras      https://cloud.cerebras.ai                  api.cerebras.ai/v1
#   Google AI     https://aistudio.google.com/apikey         generativelanguage.googleapis.com/v1beta/openai
#   HuggingFace   https://huggingface.co/settings/tokens     router.huggingface.co/v1
#   Mistral       https://console.mistral.ai                 api.mistral.ai/v1
#   NVIDIA NIM    https://build.nvidia.com                   integrate.api.nvidia.com/v1
#
# NOTE on the HF token: the one used for `git subtree push` to Spaces will
# authenticate the router too, but HF inference credits are a separate and
# fairly small monthly allowance — treat it as one more rung, not a big win.
#
# `label` names the endpoint in logs (a bare base_url is ambiguous once several
# models share a host). `timeout` matters once the ladder is long: the global
# 45s across ten members retried twice outlives even the 300s client timeout.
# `reasoning_effort: low` on gpt-oss models takes a committee verdict from 2,146
# tokens to 929 for the same five seats and the same decision — set it wherever
# the model supports it.
# LLM_FALLBACKS=[
#   {"label":"groq/gpt-oss","base_url":"https://api.groq.com/openai/v1","model":"openai/gpt-oss-120b","api_key":"gsk_...","max_tokens":2000,"max_concurrency":2,"timeout":20,"extra_body":{"reasoning_effort":"low"}},
#   {"label":"cerebras","base_url":"https://api.cerebras.ai/v1","model":"llama-3.3-70b","api_key":"csk-...","max_concurrency":2,"timeout":20},
#   {"label":"google","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","model":"gemini-2.0-flash","api_key":"AIza...","timeout":20},
#   {"label":"hf-router","base_url":"https://router.huggingface.co/v1","model":"meta-llama/Llama-3.3-70B-Instruct","api_key":"hf_...","timeout":25},
#   {"label":"mistral","base_url":"https://api.mistral.ai/v1","model":"mistral-small-latest","api_key":"...","timeout":20}
# ]
AI_ENABLED=true

# --- Research (company news + macro web search) ---
# Gives the AI something to read besides the price chart: company headlines per
# ticker, and one shared world/market brief a day. With both blank the research
# layer is simply off and every surface behaves exactly as it did before.
#
# Finnhub (https://finnhub.io/register) — company news. Free tier, no card,
# 60 requests a minute. Coverage is strongest on US listings; most TSX tickers
# come back empty. That is reported as "no coverage" and is deliberately NOT
# treated as "no bad news" — the guardrail only acts on a symbol it could
# actually read.
FINNHUB_API_KEY=
#
# Tavily (https://app.tavily.com) — the macro read. ~1,000 free credits a
# month, and this spends ONE search a day for the whole application: the brief
# is cached per day and shared by every user, every plan and every ticker.
TAVILY_API_KEY=
#
# Master switch, and the per-provider mock overrides. Cost model: a 65-ticker
# scan asks for news about its ~6 finalists only, and adds zero LLM calls.
RESEARCH_ENABLED=true
NEWS_USE_MOCK=false
WEBSEARCH_USE_MOCK=false

# --- CORS ---
CORS_ORIGINS=*
