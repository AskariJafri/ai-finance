# Expo reads EXPO_PUBLIC_* vars at build time. Copy to `.env`.
#
# Android emulator: host machine is reachable at 10.0.2.2
# iOS simulator:    use http://localhost:8000/api/v1
# Physical device:  use your computer's LAN IP, e.g. http://192.168.1.50:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
